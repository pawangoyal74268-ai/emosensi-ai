# EmoSense AI — Environment Variables Configuration Template
# Copy this file to .env and adjust variables as needed.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (SQLite default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL for future migration:
# DATABASE_URL="postgresql://user:password@localhost:5432/emosense?schema=public"

# Authentication & Session Secrets (Replace with secure random strings in production)
JWT_SECRET=your-secure-jwt-secret-placeholder
SESSION_SECRET=your-secure-session-secret-placeholder

# AI Provider API Keys (Optional - development mode activates automatically if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
